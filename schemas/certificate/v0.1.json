{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshdag.dev/schemas/certificate/v0.1.json",
  "title": "FreshDAG Validity Certificate",
  "description": "See docs/contracts/certificate-contract.md",
  "type": "object",
  "required": ["cert_id", "schema", "artifact", "produced_by", "depends_on", "status", "observation_coverage"],
  "properties": {
    "cert_id":   { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "schema":    { "const": "freshdag.certificate/v0.1" },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "content_hash", "size"],
      "properties": {
        "id":           { "type": "string" },
        "path":         { "type": "string" },
        "kind":         { "type": "string" },
        "content_hash": { "type": "string" },
        "size":         { "type": "integer", "minimum": 0 }
      }
    },
    "produced_by": {
      "type": "object",
      "required": ["computation_id", "adapter", "started", "ended"],
      "properties": {
        "computation_id": { "type": "string" },
        "recipe":         { "type": ["string", "null"] },
        "recipe_hash":    { "type": ["string", "null"] },
        "adapter":        { "type": "string" },
        "started":        { "type": "string", "format": "date-time" },
        "ended":          { "type": "string", "format": "date-time" }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "scheme", "trust_class", "fingerprint", "observed_at"],
        "properties": {
          "key":         { "type": "string" },
          "scheme":      { "type": "string" },
          "trust_class": { "enum": ["exact", "versioned", "heuristic", "volatile"] },
          "fingerprint": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "produced_by": { "type": ["string", "null"] },
          "ttl_seconds": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "comparator": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":   { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "status": {
      "type": "object",
      "required": ["value", "checked"],
      "properties": {
        "value":   { "enum": ["valid", "likely-valid", "stale", "unknown"] },
        "checked": { "type": "string", "format": "date-time" },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dependency_key", "reason"],
            "properties": {
              "dependency_key": { "type": "string" },
              "reason": {
                "description": "Closed set of machine-checkable reason codes; mirrors freshdag_core::dependency::ReasonCode.",
                "enum": [
                  "drift",
                  "probe-unknown",
                  "no-probe-available",
                  "trust-class-heuristic-caps-at-likely-valid",
                  "trust-class-volatile-caps-at-likely-valid",
                  "ttl-expired",
                  "coverage-deficit",
                  "no-dependencies-observed",
                  "probe-trust-demoted",
                  "producer-missing-from-coverage",
                  "volatile-within-ttl-unprobed",
                  "dependency-changed-during-computation"
                ]
              },
              "detail": {
                "description": "Human context only. MUST NOT be load-bearing for any decision.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "observation_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["producer", "version", "role"],
        "properties": {
          "producer":            { "type": "string" },
          "version":             { "type": "string" },
          "role":                { "description": "Vantage point this producer observes from. Only 'observer' can discharge the bash/task coverage obligation; adapters are blind inside subprocesses by construction.", "enum": ["adapter", "observer", "probe"] },
          "emits":               { "description": "Event-kind patterns this producer declares it emits; mirrors CoverageEntry.emits. Required for the coverage-deficit rule to be checkable from the certificate alone.", "type": "array", "items": { "type": "string" } },
          "partial": {
            "description": "Event-kind patterns this producer emits only partially, mirroring CoverageEntry.partial. Present on the certificate so a third party can re-check the coverage-deficit rule without the store: an entry whose reason is 'under-approximates' or 'blind-in-scope' does NOT discharge an observation obligation for that kind. Each value is either a {reason, note} object or, for pre-ADR-0011 producers, a bare note string, which is read as 'under-approximates'.",
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "description": "Legacy shape (pre-ADR-0011): a bare human-readable note. Read as reason 'under-approximates', because a producer that cannot state its direction of error must get the conservative answer.",
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "reason": {
                      "description": "Which direction this producer's coverage of the kind errs in. Machine-readable; the only field consumers may decide on. REQUIRED — no default, for the same reason `role` has none.",
                      "enum": ["blind-in-scope", "over-approximates", "under-approximates"]
                    },
                    "note": {
                      "description": "Human-readable explanation. NON-NORMATIVE: no consumer may branch on it. MUST be deterministic (it is inside the cert_id preimage) and MUST NOT carry secrets.",
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "known_limitations":   { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Invariant #7: status.value cannot be 'valid' when any dependency's trust_class is 'heuristic' or 'volatile'. The strongest achievable status in those cases is 'likely-valid'.",
      "if": {
        "properties": {
          "depends_on": {
            "type": "array",
            "contains": {
              "properties": { "trust_class": { "enum": ["heuristic", "volatile"] } },
              "required": ["trust_class"]
            }
          }
        }
      },
      "then": {
        "properties": { "status": { "properties": { "value": { "not": { "const": "valid" } } } } }
      }
    },
    {
      "description": "Invariant #9: recipe_hash must be present when status.value is 'valid' or 'likely-valid'.",
      "if": {
        "properties": { "status": { "properties": { "value": { "enum": ["valid", "likely-valid"] } } } }
      },
      "then": {
        "properties": {
          "produced_by": {
            "properties": { "recipe_hash": { "type": "string" } },
            "required": ["recipe_hash"]
          }
        }
      }
    },
    {
      "description": "Invariant #6: status.reasons must be populated when status.value is not 'valid'.",
      "if": {
        "properties": { "status": { "properties": { "value": { "not": { "const": "valid" } } } } }
      },
      "then": {
        "properties": {
          "status": {
            "properties": { "reasons": { "type": "array", "minItems": 1 } },
            "required": ["reasons"]
          }
        }
      }
    }
  ]
}
